# Internet Troubleshooting Agent - example environment file.
# Copy to `.env` and fill in a real key. Never commit `.env`.

# Required. Google AI Studio API key for the Gemini model.
GOOGLE_API_KEY=your-key-here

# The chat model driving the conversation.
ISP_MODEL=gemini-flash-3.6

# Policy: hand over to a human after this many distinct troubleshooting
# steps have been completed without resolving the issue.
ISP_MAX_FAILED_STEPS=2

# Safety limit on tool-calling loops within a single turn.
ISP_RECURSION_LIMIT=8
